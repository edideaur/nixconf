{ pkgs, ... }:
let
  # Scripts
  lidScript = pkgs.writeShellScript "lid-switch.sh" ''
    ACTION="$1"
    STATE_DIR="''${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    STATE_FILE="$STATE_DIR/lid_saved_brightness"

    is_keep_awake() {
        local ipc_res
        ipc_res=$(qs -c ii ipc call idle isInhibited 2>/dev/null)
        if [ "$ipc_res" = "true" ]; then
            return 0
        elif [ "$ipc_res" = "false" ]; then
            return 1
        fi

        if systemd-inhibit --list 2>/dev/null | grep -q "handle-lid-switch"; then
            return 0
        fi

        local states_file="$HOME/.local/state/quickshell/states.json"
        if [ -f "$states_file" ] && ${pkgs.jq}/bin/jq -e '.idle.inhibit == true' "$states_file" >/dev/null 2>&1; then
            return 0
        fi

        return 1
    }

    case "$ACTION" in
        close)
            if ! is_keep_awake; then
                exit 0
            fi

            if [ ! -f "$STATE_FILE" ]; then
                current=$(${pkgs.brightnessctl}/bin/brightnessctl -c backlight get 2>/dev/null)
                if [ -n "$current" ] && [ "$current" -gt 0 ] 2>/dev/null; then
                    echo "$current" > "$STATE_FILE"
                fi
            fi

            ${pkgs.brightnessctl}/bin/brightnessctl -c backlight set 1% -q
            ;;

        open)
            if [ -f "$STATE_FILE" ]; then
                saved=$(cat "$STATE_FILE" 2>/dev/null)
                rm -f "$STATE_FILE"
                if [ -n "$saved" ] && [ "$saved" -gt 0 ] 2>/dev/null; then
                    ${pkgs.brightnessctl}/bin/brightnessctl -c backlight set "$saved" -q
                else
                    ${pkgs.brightnessctl}/bin/brightnessctl -c backlight set 50% -q
                fi
            fi
            ;;

        *)
            echo "Usage: $0 {close|open}"
            exit 1
            ;;
    esac
  '';

  monitorAutoScript = pkgs.writeShellScript "monitor-auto.sh" ''
    INTERNAL="eDP-1"
    INTERNAL_MODE="1920x1080@60"
    EXTERNAL="HDMI-A-1"
    EXTERNAL_MODE="2560x1440@143.981"

    CONF="$HOME/.config/hypr/monitors.lua"
    mkdir -p "$(dirname "$CONF")"

    connected=$(hyprctl monitors all -j | ${pkgs.jq}/bin/jq -r '.[].name')

    if grep -qx "$EXTERNAL" <<<"$connected"; then
        cat >"$CONF" <<EOF
    -- Auto-generated by monitor-auto.sh
    hl.monitor({
      output = "$EXTERNAL",
      mode = "$EXTERNAL_MODE",
      position = "0x0",
      scale = 1,
    })
    hl.monitor({
      output = "$INTERNAL",
      disabled = true,
    })
    EOF
    else
        cat >"$CONF" <<EOF
    -- Auto-generated by monitor-auto.sh
    hl.monitor({
      output = "$INTERNAL",
      mode = "$INTERNAL_MODE",
      position = "0x0",
      scale = 1.25,
    })
    EOF
    fi

    hyprctl reload
  '';

  monitorListenerScript = pkgs.writeShellScript "monitor-listener.sh" ''
    SCRIPT="${monitorAutoScript}"

    resolve_socket() {
        local sig="$HYPRLAND_INSTANCE_SIGNATURE"
        if [ -z "$sig" ]; then
            sig=$(hyprctl instances -j 2>/dev/null | ${pkgs.jq}/bin/jq -r '.[0].instance')
        fi
        echo "''${XDG_RUNTIME_DIR}/hypr/''${sig}/.socket2.sock"
    }

    "$SCRIPT"

    while true; do
        SOCKET=$(resolve_socket)
        if [ -S "$SOCKET" ]; then
            ${pkgs.socat}/bin/socat -U - "UNIX-CONNECT:$SOCKET" | while read -r line; do
                case "$line" in
                    monitoradded*|monitorremoved*|monitoraddedv2*|monitorremovedv2*)
                        "$SCRIPT"
                        ;;
                esac
            done
        fi
        sleep 2
    done
  '';
in
{
  # Install custom scripts into ~/.config/hypr/
  home.file = {
    ".config/hypr/monitor-auto.sh" = {
      source = monitorAutoScript;
      executable = true;
    };
    ".config/hypr/monitor-listener.sh" = {
      source = monitorListenerScript;
      executable = true;
    };
    ".config/hypr/custom/scripts/lid-switch.sh" = {
      source = lidScript;
      executable = true;
    };

    # Keybinds override matching your exact preferences:
    # Super+T -> Alacritty
    # Super+B -> Helium Browser
    # Super alone -> App drawer (ii default)
    # Super+F -> Dolphin
    # Super+Q -> Close window
    # Super+L -> hyprlock
    # Super+Shift+S / Print -> Screenshot
    ".config/hypr/custom/keybinds.lua".text = ''
      -- Custom keybindings for edideaur
      local lidScript = "${lidScript}"

      -- Lid switch
      hl.bind("switch:on:Lid Switch", hl.dsp.exec_cmd(lidScript .. " close"), { locked = true })
      hl.bind("switch:off:Lid Switch", hl.dsp.exec_cmd(lidScript .. " open"), { locked = true })

      -- App shortcuts
      hl.bind("SUPER + T", hl.dsp.exec_cmd("alacritty"), { description = "App: Alacritty Terminal" })
      hl.bind("SUPER + B", hl.dsp.exec_cmd("helium"), { description = "App: Helium Browser" })
      hl.bind("SUPER + F", hl.dsp.exec_cmd("dolphin"), { description = "App: Dolphin File Manager" })
      hl.bind("SUPER + Q", hl.dsp.window.close(), { description = "Window: Close" })
      hl.bind("SUPER + L", hl.dsp.exec_cmd("loginctl lock-session"), { description = "Session: Lock" })

      -- Screenshots
      hl.bind("SUPER + SHIFT + S", hl.dsp.global("quickshell:regionScreenshot"), { description = "Utilities: Screen snip" })
      hl.bind("Print", hl.dsp.exec_cmd("grim - | wl-copy"), { locked = true, description = "Utilities: Screenshot >> clipboard" })
    '';

    # Custom execs: auto-run monitor listener on startup
    ".config/hypr/custom/execs.lua".text = ''
      -- Custom autostart hooks
      hl.on("hyprland.start", function()
          hl.exec_cmd("${monitorListenerScript}")
      end)
    '';
  };
}
